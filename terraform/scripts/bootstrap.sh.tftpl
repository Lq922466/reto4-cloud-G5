#!/usr/bin/env bash
set -euo pipefail
# Terraform proporciona el nombre del nodo y las claves públicas del equipo.
hostnamectl set-hostname '${hostname}'
timedatectl set-timezone Europe/Madrid

ssh_dir=/home/ubuntu/.ssh
install -d -m 0700 -o ubuntu -g ubuntu "$ssh_dir"
touch "$ssh_dir/authorized_keys"
chown ubuntu:ubuntu "$ssh_dir/authorized_keys"
chmod 0600 "$ssh_dir/authorized_keys"
while IFS= read -r key; do
    [[ -n "$key" ]] || continue
    grep -Fxq -- "$key" "$ssh_dir/authorized_keys" ||
        printf '%s\n' "$key" >> "$ssh_dir/authorized_keys"
done <<'PUBLIC_KEYS'
${join("\n", public_keys)}
PUBLIC_KEYS

install -m 0644 /dev/null /etc/ssh/sshd_config.d/00-reto4.conf
cat > /etc/ssh/sshd_config.d/00-reto4.conf <<'SSH'
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
SSH
sshd -t
systemctl reload ssh

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io
systemctl enable --now docker
usermod -aG docker ubuntu
